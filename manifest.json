{
  "manifest_version": 3,
  "name": "YouTube Bookmark Extension",
  "version": "1.0",
  "description": "A Chrome extension to save and categorize YouTube video and channel bookmarks.",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
